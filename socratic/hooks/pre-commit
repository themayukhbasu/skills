#!/bin/sh
# Socratic approve-gate hook. In `gate: strict` mode, blocks a gated commit until
# /socratic:approve has passed for exactly the staged changes. Installed by /socratic:setup.
#
#   gated:       touches `gate_paths` (empty: any path) and changes >= `gate_min_lines` there
#   pass marker: .socratic/approvals/<git write-tree>   (the id of exactly what is staged)
#   escape:      SOCRATIC_ESCAPE=1 [SOCRATIC_REASON="..."] git commit ...
#                (logged to .socratic/escapes.log; folded into oversight.yml on the next summary)

set -f  # gate_paths globs are pathspecs, not shell globs
root=$(git rev-parse --show-toplevel) || exit 0
cfg="$root/.socratic/config.yml"
[ -f "$cfg" ] || exit 0

key() { sed -n "s/^$1:[[:space:]]*\([^#[:space:]]*\).*/\1/p" "$cfg" | head -n 1; }

[ "$(key gate)" = "strict" ] || exit 0
git diff --cached --quiet && exit 0

# gate_paths: block-style list items under the key, as git glob pathspecs
set --
for g in $(awk '/^gate_paths:/ {on=1; next} on && /^[^[:space:]#]/ {on=0} on && /^[[:space:]]*-[[:space:]]/ {sub(/^[[:space:]]*-[[:space:]]*/, ""); sub(/[[:space:]]*#.*/, ""); gsub(/["\047]/, ""); print}' "$cfg"); do
  set -- "$@" ":(glob)$g"
done

min=$(key gate_min_lines)
case "$min" in ''|*[!0-9]*) min=0 ;; esac
changed=$(git diff --cached --numstat -- "$@" | awk '{ if ($1 == "-") n += 1000000; else n += $1 + $2 } END { print n + 0 }')
[ "$changed" -eq 0 ] && exit 0
[ "$changed" -lt "$min" ] && exit 0

tree=$(git write-tree) || exit 1

if [ "$SOCRATIC_ESCAPE" = "1" ]; then
  printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tree" "${SOCRATIC_REASON:-no reason given}" \
    >> "$root/.socratic/escapes.log"
  echo "socratic: approve gate escaped for $tree (logged)." >&2
  exit 0
fi

[ -f "$root/.socratic/approvals/$tree" ] && exit 0

cat >&2 <<MSG
socratic: commit blocked. The approve gate (strict) hasn't passed for these staged changes.
  Run /socratic:approve with your agent, then commit again.
  Urgent? SOCRATIC_ESCAPE=1 SOCRATIC_REASON="why" git commit ...  (logged)
MSG
exit 1
